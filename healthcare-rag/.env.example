# ── HuggingFace cache (quan trọng trên Windows!) ───────────────
# Nếu bị lỗi "FileNotFoundError: .cache\huggingface" → bỏ comment dòng dưới
# HF_HOME=C:\Users\ADMIN\.cache\huggingface

# ── Qdrant ─────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=healthcare_diabetes
QDRANT_API_KEY=healthcare-local-key

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
SESSION_TTL_S=3600
SESSION_MAX_TURNS=20

# ──── Embedding Model (đa ngôn ngữ, hỗ trợ tiếng Việt)─────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── LLM ────────────────────────────────────────────────────────
LLM_MODEL=gemini-2.5-flash
MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=20
LLM_MAX_RETRIES=2


# ── RAG ────────────────────────────────────────────────────────
RAG_TOP_K=4
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ── Admin ──────────────────────────────────────────────────────
ADMIN_SECRET_KEY=healthcare-admin-dev
DOCTOR_SECRET_KEY=healthcare-doctor-dev

