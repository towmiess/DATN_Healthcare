# Database
POSTGRES_DB=healthcare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/healthcare
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-strong-db-password

# Redis
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_TIMEOUT=6s

# Mail
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_DEBUG=false
MAIL_USERNAME=healthcareteams.work@gmail.com
MAIL_PASSWORD=hihiihi
APP_MAIL_FROM_NAME=Team Support

# Eureka
EUREKA_CLIENT_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery-server:8761/eureka
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true

# App
CORS_ALLOWED_ORIGINS=https://healthcarediabetes.site
GATEWAY_INTERNAL_SECRET=replace-with-a-long-random-shared-secret

# JWT
JWT_ACCESS_SECRET=replace-with-a-base64-encoded-access-secret
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_SECRET=replace-with-a-base64-encoded-refresh-secret
JWT_REFRESH_EXPIRATION=1209600000

# JPA
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=none
