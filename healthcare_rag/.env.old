# ================================================================
# .env — Copy file này thành .env rồi điền API key của bạn
# KHÔNG commit file .env lên GitHub!
# ================================================================

# Lấy tại: https://console.anthropic.com
ANTHROPIC_API_KEY=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

# ChromaDB lưu local (không cần đăng ký, chạy offline được)
CHROMA_PERSIST_DIR=./data/chroma_db

# Model embedding đa ngôn ngữ (hỗ trợ tiếng Việt tốt)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM settings
LLM_MODEL=claude-sonnet-4-20250514
MAX_TOKENS=2048

# RAG settings
TOP_K_RESULTS=5       # Lấy 5 đoạn văn liên quan nhất
CHUNK_SIZE=500        # Mỗi chunk ~500 token
CHUNK_OVERLAP=50      # Overlap 50 token giữa các chunk

# API
API_HOST=0.0.0.0
API_PORT=8000
